/* 基本設定 */
body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #2c3e50; /* 背景をダークグレーに */
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    margin: 0;
    color: #ecf0f1;
}

/* デジタルフォントの適用 */
.digital-text {
    font-family: 'Orbitron', sans-serif;
    letter-spacing: 2px;
}

/* 計測器本体のケース */
.device-container {
    background-color: #1a252f;
    border: 2px solid #34495e;
    border-radius: 15px;
    padding: 30px;
    box-shadow: 0 15px 30px rgba(0,0,0,0.5), inset 0 0 10px rgba(0,0,0,0.8);
    width: 800px;
    max-width: 95%;
}

.device-header {
    border-bottom: 2px solid #34495e;
    padding-bottom: 15px;
    margin-bottom: 25px;
}

.device-header h1 {
    margin: 0;
    font-size: 24px;
    color: #95a5a6;
    letter-spacing: 4px;
}

.device-body {
    display: flex;
    gap: 30px;
}

/* --- 入力パネル（左側） --- */
.input-panel, .output-panel {
    flex: 1;
    background-color: #233140;
    padding: 20px;
    border-radius: 10px;
    box-shadow: inset 0 2px 5px rgba(0,0,0,0.3);
}

.input-panel h2 {
    font-size: 14px;
    color: #7f8c8d;
    margin-top: 0;
}

.control-group {
    margin-bottom: 30px;
}

.control-group label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-weight: bold;
    margin-bottom: 10px;
}

/* === ここから：計測器風スライダーのデザイン === */
input[type=range] {
    -webkit-appearance: none;
    width: 100%;
    background: transparent;
}
input[type=range]:focus {
    outline: none;
}
/* スライダーの「溝」 */
input[type=range]::-webkit-slider-runnable-track {
    width: 100%;
    height: 12px;
    cursor: pointer;
    background: #0b1116; /* 深い溝を表現 */
    border-radius: 6px;
    border: 1px solid #34495e;
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.8);
}
/* スライダーの「つまみ」 */
input[type=range]::-webkit-slider-thumb {
    height: 30px;
    width: 20px;
    border-radius: 4px;
    background: linear-gradient(to bottom, #7f8c8d, #34495e); /* 金属っぽいグラデーション */
    border: 1px solid #2c3e50;
    cursor: pointer;
    -webkit-appearance: none;
    margin-top: -10px; /* 溝の中央に配置 */
    box-shadow: 0 3px 5px rgba(0,0,0,0.5), inset 0 1px 2px rgba(255,255,255,0.2);
}
/* ======================================= */

/* --- 出力パネル（右側） --- */
.display-screen {
    background-color: #0b1116;
    border: 3px solid #2c3e50;
    border-radius: 8px;
    padding: 20px;
    text-align: center;
    margin-bottom: 30px;
    position: relative;
    box-shadow: inset 0 0 20px rgba(0,0,0,0.8);
}

.display-label {
    position: absolute;
