.led {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: #2c3e50; /* 消灯状態のグレー */
    border: 2px solid #1a252f;
    box-shadow: inset 0 0 5px rgba(0,0,0,0.8);
    transition: all 0.2s;
}

