.led.yellow.on { background-color: #f1c40f; box-shadow: 0 0 15px #f1c40f, inset 0 0 5px white; border-color: #f39c12; }
.led.red.on { background-color: #e74c3c; box-shadow: 0 0 15px #e74c3c, inset 0 0 5px white; border-color: #c0392b; }
